<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <title>Your Manifest Logs | BagVerse</title>
</head>

<body class="min-h-screen bg-[#FCFCFC] text-neutral-900 antialiased font-sans flex flex-col justify-between selection:bg-black selection:text-white">
    <%- include("../partials/navbar") %>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">

        <header class="pb-10 border-b border-neutral-200/60 text-center sm:text-left mb-12">
            <nav class="text-[10px] font-bold tracking-[0.2em] text-neutral-400 uppercase mb-4 flex items-center justify-center sm:justify-start gap-2.5 font-mono">
                <a href="/" class="hover:text-black transition-colors">Home</a>
                <span class="text-neutral-300">/</span>
                <span class="text-neutral-900">Order Logs</span>
            </nav>
            <h1 class="text-3xl font-black tracking-wider text-neutral-900 uppercase font-mono">
                Your <span class="font-light text-neutral-400">Orders</span>
            </h1>
            <p class="text-xs text-neutral-500 mt-3 max-w-md uppercase tracking-wider leading-relaxed font-mono font-medium">
                historical records of committed purchases and active shipping trajectories.
            </p>
        </header>

        <% if (orders && orders.length > 0) { %>
            <div class="space-y-10">
                <% orders.toReversed().forEach(order => { %>
                    <div class="bg-white border border-neutral-200 rounded-none overflow-hidden transition-all duration-300 hover:border-neutral-900 flex flex-col">

                        <div class="bg-neutral-50 border-b border-neutral-200 px-5 py-4 flex flex-wrap items-center justify-between gap-4 font-mono text-[10px] uppercase tracking-wider">
                            <div class="flex items-center gap-6">
                                <div>
                                    <span class="text-neutral-400 block mb-0.5">Manifest Code</span>
                                    <span class="font-bold text-neutral-900">#<%= order._id.toString().substring(0, 10).toUpperCase() %></span>
                                </div>
                                <div>
                                    <span class="text-neutral-400 block mb-0.5">Timestamp</span>
                                    <span class="font-bold text-neutral-700">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-US', {year: 'numeric' , month: 'short' , day: 'numeric' }) %>
                                    </span>
                                </div>
                                <div>
                                    <span class="text-neutral-400 block mb-0.5">Aggregate Net Value</span>
                                    <span class="font-black text-neutral-900">$<%= order.totalPrice %></span>
                                </div>
                            </div>

                            <div>
                                <% if (order.status === 'Delivered') { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-neutral-100 text-neutral-900 border border-neutral-300 font-bold">
                                        // DELIVERED
                                    </span>
                                <% } else if (order.status === 'Shipped') { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-neutral-900 text-white font-bold">
                                        IN TRANSIT
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white text-neutral-900 border border-neutral-900 font-bold animate-pulse">
                                        PROCESSING
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div class="divide-y divide-neutral-100 px-5 flex-1">
                            
                            <% order.orderItems.forEach(item => { %>
                                <div class="py-5 flex items-center justify-between gap-4 group">
                                    <div class="flex items-center gap-4">

                                        <div class="w-14 h-16 bg-neutral-50 border border-neutral-100 shrink-0 overflow-hidden relative flex items-center justify-center">
                                            <% if (item.product && item.product.image) { %>
                                                <img src="data:<%= item.product.imageType %>;base64,<%= item.product.image.toString('base64') %>"
                                                    alt="" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <i class="fa-solid fa-box text-neutral-300 text-sm"></i>
                                            <% } %>
                                        </div>

                                        <div>
                                            <h4 class="font-mono text-xs font-bold text-neutral-800 uppercase tracking-wider line-clamp-1">
                                                <%= item.product ? item.product.name : 'Premium Line Item Archive' %>
                                            </h4>
                                            <p class="font-mono text-[9px] text-neutral-400 tracking-widest mt-1 uppercase">
                                                Units Managed: <span class="text-neutral-900 font-bold"><%= item.quantity %></span>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="text-right font-mono text-xs font-black text-neutral-900 tracking-wider">
                                        $<%= item.price * item.quantity %>
                                    </div>
                                </div>
                            <% }); %>
                            
                        </div>

                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-24 border border-neutral-200 rounded-none max-w-md mx-auto font-mono bg-white">
                <div class="w-12 h-12 border border-neutral-200 flex items-center justify-center mx-auto mb-5 text-neutral-400 rounded-none">
                    <i class="fa-solid fa-timeline text-xs"></i>
                </div>
                <h3 class="text-xs font-black text-neutral-900 uppercase tracking-[0.2em]">No Operations Found</h3>
                <p class="text-[10px] text-neutral-400 mt-2 max-w-xs mx-auto uppercase tracking-wide">
                    you currently hold no committed product manifests on this account node.
                </p>
                <a href="/" class="inline-block mt-6 text-[10px] font-bold uppercase tracking-[0.2em] bg-neutral-950 text-white px-5 py-3 rounded-none hover:bg-neutral-800 transition-all">
                    &larr; Initialize First Acquisition
                </a>
            </div>
        <% } %>

    </main>

    <%- include("../partials/footer") %>
</body>

</html>