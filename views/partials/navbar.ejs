                <a href="/admin/dashboard" class="<%= userRole === 'admin' ? 'block' : 'hidden' %> relative py-2 transition-colors duration-200 <%= currentPage === 'dashboard' ? 'text-neutral-950' : 'text-neutral-400 hover:text-neutral-950' %> after:absolute after:bottom-0 after:left-0 after:w-full after:h-px after:bg-neutral-950 after:transform <%= currentPage === 'dashboard' ? 'after:scale-x-100' : 'after:scale-x-0' %> hover:after:scale-x-100 after:transition-transform after:duration-300">
