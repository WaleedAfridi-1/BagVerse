                    <i class="fa-solid fa-clock-history text-base md:mr-1.5"></i>
                    <span class="hidden md:inline text-[9px]">// LOGS</span>
                </a>

                <a href="/cart" class="p-2 hover:text-neutral-500 transition-colors duration-200 relative inline-flex items-center mr-1" aria-label="Cart">
                    <i class="bi bi-bag text-lg"></i>
                    <% if (cart && cart.items && cart.items.length > 0) { %>
                        <span id="nav-cart-count" class="absolute -top-0.5 -right-0.5 bg-neutral-950 text-white text-[8px] font-bold w-4 h-4 rounded-none flex items-center justify-center border border-white font-mono">
                            <%= cart.items.length %>
                        </span>
                    <% } %>
                </a>

                <a href="/logout" class="hidden md:inline-block border border-neutral-200 px-3.5 py-1.5 text-[9px] font-bold tracking-widest font-mono uppercase rounded-none hover:bg-neutral-950 hover:text-white hover:border-neutral-950 transition-all duration-150">
