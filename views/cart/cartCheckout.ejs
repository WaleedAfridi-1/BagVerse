<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <title>Checkout Protocol / BagVerse Studio</title>
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-800 antialiased font-sans">
    <%- include("../partials/navbar") %>

    <main class="max-w-7xl mx-auto py-16 px-6 lg:px-12">
        <div class="mb-12 border-b border-neutral-200 pb-6">
            <h1 class="text-3xl font-black tracking-widest text-neutral-950 uppercase font-mono">Checkout</h1>
            <p class="mt-1 text-xs text-neutral-400 tracking-wide">// Finalize destination logistical route and verification parameters below.</p>
        </div>

        <% let checkoutDiscount = 0; %>
        <% if (cart && cart.items) { %>
            <% cart.items.forEach((item) => { %>
                <% checkoutDiscount += (item.product.discount * item.quantity); %>
            <% }); %>
        <% } %>

        <form action="/order/place" method="POST" class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
            
            <div class="lg:col-span-2 space-y-8">
                
                <div class="bg-white border border-neutral-200 p-8 space-y-6">
                    <h2 class="text-xs font-bold font-mono text-neutral-950 uppercase tracking-[0.2em] border-b border-neutral-100 pb-3 flex items-center gap-2">
                        <i class="fa-regular fa-user text-neutral-400"></i> // 01. Customer Info
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-[10px] font-bold font-mono text-neutral-400 uppercase tracking-wider mb-2">Full Name</label>
                            <input type="text" name="name" required class="w-full text-xs p-3.5 border border-neutral-300 focus:outline-none focus:border-neutral-950 bg-neutral-50/30 tracking-wide" placeholder="John Doe">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold font-mono text-neutral-400 uppercase tracking-wider mb-2">Email Address</label>
                            <input type="email" name="email" required class="w-full text-xs p-3.5 border border-neutral-300 focus:outline-none focus:border-neutral-950 bg-neutral-50/30 tracking-wide" placeholder="john@example.com">
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-neutral-200 p-8 space-y-6">
                    <h2 class="text-xs font-bold font-mono text-neutral-950 uppercase tracking-[0.2em] border-b border-neutral-100 pb-3 flex items-center gap-2">
                        <i class="fa-solid fa-truck text-neutral-400"></i> // 02. Shipping Logistics
                    </h2>
                    <div class="space-y-6">
                        <div>
                            <label class="block text-[10px] font-bold font-mono text-neutral-400 uppercase tracking-wider mb-2">Street Address</label>
                            <input type="text" name="address" required class="w-full text-xs p-3.5 border border-neutral-300 focus:outline-none focus:border-neutral-950 bg-neutral-50/30 tracking-wide" placeholder="Suite, House No, Building, Street Name...">
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div>
                                <label class="block text-[10px] font-bold font-mono text-neutral-400 uppercase tracking-wider mb-2">City</label>
                                <input type="text" name="city" required class="w-full text-xs p-3.5 border border-neutral-300 focus:outline-none focus:border-neutral-950 bg-neutral-50/30 tracking-wide" placeholder="Karachi">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold font-mono text-neutral-400 uppercase tracking-wider mb-2">Phone Number</label>
                                <input type="tel" name="phone" required class="w-full text-xs p-3.5 border border-neutral-300 focus:outline-none focus:border-neutral-950 bg-neutral-50/30 tracking-wide" placeholder="03001234567">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold font-mono text-neutral-400 uppercase tracking-wider mb-2">Postal Code</label>
                                <input type="text" name="postalCode" required class="w-full text-xs p-3.5 border border-neutral-300 focus:outline-none focus:border-neutral-950 bg-neutral-50/30 tracking-wide" placeholder="75500">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-neutral-200 p-8 space-y-6">
                    <h2 class="text-xs font-bold font-mono text-neutral-950 uppercase tracking-[0.2em] border-b border-neutral-100 pb-3 flex items-center gap-2">
                        <i class="fa-regular fa-credit-card text-neutral-400"></i> // 03. Settlement Protocol
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <label class="flex items-center justify-between p-5 border border-neutral-950 bg-neutral-50/50 cursor-pointer group">
                            <div class="flex items-center gap-4">
                                <i class="fa-solid fa-money-bill-wave text-base text-neutral-950"></i>
                                <div class="space-y-0.5">
                                    <p class="font-bold text-neutral-950 text-xs uppercase tracking-wide">Cash on Delivery (COD)</p>
                                    <p class="text-[10px] text-neutral-400 font-mono tracking-tight">Settle clearing upon physical arrival</p>
                                </div>
                            </div>
                            <input type="radio" name="paymentMethod" value="COD" checked class="w-3.5 h-3.5 accent-neutral-950 cursor-pointer">
                        </label>

                        <label class="flex items-center justify-between p-5 border border-neutral-200 hover:border-neutral-400 cursor-pointer group transition duration-200">
                            <div class="flex items-center gap-4">
                                <i class="fa-solid fa-credit-card text-base text-neutral-400 group-hover:text-neutral-950 transition-colors"></i>
                                <div class="space-y-0.5">
                                    <p class="font-bold text-neutral-700 group-hover:text-neutral-950 text-xs uppercase tracking-wide transition-colors">Credit / Debit Card</p>
                                    <p class="text-[10px] text-neutral-400 font-mono tracking-tight">Secure Vault Routing (Visa, MC)</p>
                                </div>
                            </div>
                            <input type="radio" name="paymentMethod" value="Card" class="w-3.5 h-3.5 accent-neutral-950 cursor-pointer">
                        </label>
                    </div>
                </div>
            </div>

            <div class="border border-neutral-200 bg-white p-8 space-y-6 sticky top-28">
                <h2 class="text-xs font-bold font-mono uppercase tracking-[0.2em] border-b border-neutral-100 pb-4 text-neutral-950">// Summary Matrix</h2>
                
                <div class="space-y-4 font-mono text-xs">
                    <div class="flex justify-between text-neutral-400">
                        <p>Gross Subtotal</p>
                        <p class="font-bold text-neutral-950">$<%= cart.totalPrice %>.00</p>
                    </div>
                    
                    <div class="flex justify-between text-neutral-400">
                        <p>Logistics / Delivery</p>
                        <p class="font-bold text-neutral-950">$10.00</p>
                    </div>
                    
                    <div class="border-t border-neutral-200 pt-4 flex justify-between items-baseline">
                        <p class="text-xs font-bold text-neutral-950 uppercase tracking-wider">Final Clearing</p>
                        <p class="text-xl font-black font-sans text-neutral-950">$<%= (10 + cart.totalPrice)%>.00</p>
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full bg-neutral-950 hover:bg-neutral-800 text-white font-bold py-4 px-4 border border-transparent cursor-pointer transition-all duration-200 block text-center text-[10px] uppercase tracking-[0.2em]">
                        Authorize & Place Order
                    </button>
                </div>
            </div>
        </form>
    </main>
    
    <%- include("../partials/footer") %>
</body>
</html>