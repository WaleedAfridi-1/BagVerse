<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>Thank You for Your Order</title>
</head>
<body class="min-h-screen bg-gray-50 text-gray-800 antialiased font-sans flex flex-col justify-between">
    <%- include("../partials/navbar") %>

    <section class="max-w-3xl mx-auto py-16 px-4 sm:px-6 lg:px-8 grow flex items-center justify-center">
        <div class="bg-white rounded-3xl shadow-xs border border-gray-100 p-8 md:p-12 text-center space-y-8 w-full max-w-2xl">
            
            <div class="mx-auto w-24 h-24 bg-green-50 rounded-full flex items-center justify-center border border-green-100">
                <i class="fa-solid fa-circle-check text-5xl text-green-500"></i>
            </div>

            <div class="space-y-3">
                <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">Thank You for Your Order!</h1>
                <p class="text-base text-gray-500">Your order has been placed successfully and is now being processed.</p>
            </div>

            <div class="bg-amber-50/50 border border-amber-100 rounded-2xl p-4 text-left flex items-start gap-4 max-w-md mx-auto">
                <div class="p-2 bg-amber-100/60 rounded-xl text-amber-700 shrink-0">
                    <i class="fa-regular fa-comment-dots text-xl"></i>
                </div>
                <div>
                    <h4 class="font-semibold text-amber-900 text-sm">SMS Notification Sent</h4>
                    <p class="text-xs text-amber-700 mt-0.5 leading-relaxed">
                        We have sent a confirmation message to your registered phone number with your live tracking details.
                    </p>
                </div>
            </div>

            <div class="border-t border-b border-gray-100 py-6 max-w-md mx-auto text-sm text-gray-600 space-y-2">
                <div class="flex justify-between">
                    <span>Estimated Delivery:</span>
                    <span class="font-semibold text-gray-900">2 - 3 Business Days</span>
                </div>
                <div class="flex justify-between">
                    <span>Shipping Method:</span>
                    <span class="font-semibold text-gray-900">Standard Delivery</span>
                </div>
            </div>

            <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center items-center max-w-md mx-auto">
                <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center bg-gray-900 hover:bg-gray-800 text-white font-medium py-3.5 px-6 rounded-xl shadow-xs transition duration-200 hover:-translate-y-0.5 active:scale-98 text-sm tracking-wide">
                    Continue Shopping
                </a>
                <a href="/users/orders" class="w-full sm:w-auto inline-flex items-center justify-center bg-white hover:bg-gray-50 text-gray-700 font-medium py-3.5 px-6 rounded-xl border border-gray-200 transition duration-200 active:scale-98 text-sm tracking-wide">
                    Track Your Order
                </a>
            </div>
        </div>
    </section>
    
    <%- include("../partials/footer") %>
</body>
</html>