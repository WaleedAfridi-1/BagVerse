<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Tailwind v4 CDN -->
   <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <title>Your Cart / BagVerse Studio</title>
</head>

<body class="min-h-screen bg-neutral-50 text-neutral-800 antialiased font-sans">
    <%- include("../partials/navbar") %>

    <main class="max-w-7xl mx-auto py-16 px-6 lg:px-12">
        <!-- Heading Section -->
        <div class="mb-12 border-b border-neutral-200 pb-6 flex flex-col md:flex-row justify-between items-baseline gap-2">
            <div>
                <h1 class="text-3xl font-black tracking-widest text-neutral-950 uppercase font-mono">Shopping Cart</h1>
                <p class="mt-1 text-xs text-neutral-400 tracking-wide">// Verify your items before initiating checkout protocol.</p>
            </div>
            <% if(cart && cart.items.length > 0 ){ %>
                <span class="text-xs font-mono text-neutral-400 uppercase">[ <%= cart.items.length %> Unique Line-Items ]</span>
            <% } %>
        </div>

        <% if(cart && cart.items.length > 0 ){ %>
            <!-- Main Cart Grid Container -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">

                <!-- Left Column: Cart Items List -->
                <div class="lg:col-span-2 border-t border-neutral-200">
                    <!-- Desktop Header Labels -->
                    <div class="hidden md:grid grid-cols-5 gap-4 py-4 border-b border-neutral-200 text-[10px] font-bold font-mono text-neutral-400 uppercase tracking-widest">
                        <div class="col-span-2">Description</div>
                        <div class="col-span-1 text-center">Quantity</div>
                        <div class="col-span-1 text-center">Unit Price</div>
                        <div class="col-span-1 text-right">Remove</div>
                    </div>

                    <!-- Cart Items Loop -->
                    <% let totalDiscount = 0 %>
                    <% cart.items.forEach((item) => { %>
                        <!-- Fixed Discount Logic: Multiplying item quantity with individual discount -->
                        <% totalDiscount += (item.product.discount * item.quantity) %>
                        
                        <div class="grid grid-cols-1 md:grid-cols-5 gap-6 items-center py-8 border-b border-neutral-200/60">

                            <!-- Product Info (Image + Title) -->
                            <div class="col-span-1 md:col-span-2 flex items-center gap-6">
                                <div class="w-20 h-24 overflow-hidden bg-neutral-100 shrink-0 border border-neutral-200">
                                    <img class="w-full h-full object-cover transition duration-500 hover:scale-105"
                                        src="data:<%= item.product.imageType %>;base64,<%= item.product.image.toString('base64') %>"
                                        alt="<%= item.product.name %>">
                                </div>
                                <div class="space-y-1">
                                    <h3 class="font-bold text-xs text-neutral-950 uppercase tracking-wide hover:text-neutral-500 transition">
                                        <%= item.product.name %>
                                    </h3>
                                    <p class="text-[10px] font-mono text-neutral-400 uppercase">ID: <%= item.product._id.toString().slice(-6) %></p>
                                </div>
                            </div>

                            <!-- Quantity Controls -->
                            <div class="col-span-1 flex md:justify-center items-center justify-between mt-2 md:mt-0">
                                <span class="md:hidden text-[10px] font-bold font-mono text-neutral-400 uppercase">Qty:</span>
                                <div class="flex items-center border border-neutral-300 bg-white p-0.5">
                                    <a href="/cart/product/remove/quantity/<%= item.product._id %>" class="block">
                                        <button class="w-8 h-8 flex items-center justify-center font-mono text-xs text-neutral-500 hover:text-neutral-950 cursor-pointer transition active:scale-90">-</button>
                                    </a>
                                    <span class="w-8 text-center font-mono font-bold text-neutral-950 text-xs">
                                        <%= item.quantity %>
                                    </span>
                                    <a href="/cart/product/quantity/<%= item.product._id %>" class="block">
                                        <button class="w-8 h-8 flex items-center justify-center font-mono text-xs text-neutral-500 hover:text-neutral-950 cursor-pointer transition active:scale-90">+</button>
                                    </a>
                                </div>
                            </div>

                            <!-- Price -->
                            <div class="col-span-1 flex md:justify-center items-center justify-between md:text-center">
                                <span class="md:hidden text-[10px] font-bold font-mono text-neutral-400 uppercase">Price:</span>
                                <span class="font-mono font-bold text-neutral-950 text-xs">$<%= item.price %>.00</span>
                            </div>

                            <!-- Delete Action Button -->
                            <div class="col-span-1 flex md:justify-end items-center justify-between">
                                <span class="md:hidden text-[10px] font-bold font-mono text-neutral-400 uppercase">Action:</span>
                                <a href="/cart/product/<%= item.product._id %>" class="inline-block">
                                    <button class="flex items-center justify-center p-2 text-neutral-400 hover:text-neutral-950 cursor-pointer transition-colors duration-200" title="Remove line item">
                                        <i class="fa-regular fa-trash-can text-sm"></i>
                                    </button>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Right Column: Order Summary Sidebar Container -->
                <div class="border border-neutral-200 bg-white p-8 space-y-6 sticky top-28">
                    <h2 class="text-xs font-bold font-mono uppercase tracking-[0.2em] border-b border-neutral-100 pb-4 text-neutral-950">// Summary Matrix</h2>

                    <div class="space-y-4 font-mono text-xs">
                        <div class="flex justify-between text-neutral-400">
                            <p>Gross Subtotal</p>
                            <p class="font-bold text-neutral-950">$<%= cart.totalPrice %>.00</p>
                        </div>
                        <div class="flex justify-between text-neutral-400">
                            <p>Studio Discount</p>
                            <!-- Updated to use the correct multiplied variable totalDiscount -->
                            <p class="font-bold text-neutral-600">-$<%= totalDiscount %>.00</p>
                        </div>
                        <div class="flex justify-between text-neutral-400">
                            <p>Logistics / Delivery</p>
                            <p class="font-bold text-neutral-950">$10.00</p>
                        </div>

                        <div class="border-t border-neutral-200 pt-4 flex justify-between items-baseline">
                            <p class="text-xs font-bold text-neutral-950 uppercase tracking-wider">Estimated Total</p>
                            <p class="text-xl font-black font-sans text-neutral-950">$<%= (10 + cart.totalPrice) - totalDiscount %>.00</p>
                        </div>
                    </div>

                    <!-- Checkout CTA Button -->
                    <div class="pt-2">
                        <a href="/cart/checkout"
                            class="w-full bg-neutral-950 hover:bg-neutral-800 text-white font-bold py-4 px-4 border border-transparent cursor-pointer transition-all duration-200 block text-center text-[10px] uppercase tracking-[0.2em]">
                            Proceed to Checkout
                        </a>
                    </div>
                </div>

            </div>
        <% } else { %>
            <!-- Premium Studio Empty Cart State -->
            <div class="flex flex-col items-center justify-center py-24 px-6 text-center max-w-sm mx-auto border border-dashed border-neutral-300 bg-white">
                <div class="w-16 h-16 bg-neutral-50 border border-neutral-200 flex items-center justify-center mb-6 text-neutral-400">
                    <i class="fa-solid fa-basket-shopping text-xl"></i>
                </div>

                <h2 class="text-xs font-bold font-mono text-neutral-950 uppercase tracking-[0.2em]">Your vault is empty</h2>
                <p class="mt-3 text-xs text-neutral-400 leading-relaxed font-sans">
                    No items selected for initialization. Navigate through our current drops to source seasonal essentials.
                </p>

                <div class="mt-8 w-full">
                    <a href="/"
                        class="inline-flex items-center justify-center w-full bg-neutral-950 hover:bg-neutral-800 text-white font-bold py-3.5 px-6 transition-all duration-200 tracking-[0.15em] text-[10px] uppercase">
                        <i class="fa-solid fa-arrow-left mr-2 text-[9px]"></i>
                        Continue Sourcing
                    </a>
                </div>
            </div>
        <% } %>
    </main>

    <%- include("../partials/footer") %>
</body>

</html>