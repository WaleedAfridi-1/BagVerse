<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>BagVerse Admin | Create Product</title>
</head>

<body class="bg-gray-50/50 font-sans text-gray-900 antialiased min-h-screen flex">

    <div class="flex-1 flex flex-col min-w-0">

        <header class="h-20 bg-white border-b border-gray-100 flex items-center justify-between px-6 sm:px-8 z-10 shrink-0">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-400">
                <a href="/admin/products" class="hover:text-amber-800 transition-colors">Catalog</a>
                <span>/</span>
                <span class="text-gray-900">Edit Product</span>
            </div>
            <a href="/admin/products" class="text-xs font-bold uppercase tracking-wider text-gray-500 hover:text-gray-900 transition-colors flex items-center gap-1.5">
                <i class="fas fa-arrow-left"></i> Cancel
            </a>
        </header>

        <main class="flex-1 p-6 sm:p-8 overflow-y-auto flex justify-center items-start">

            <div class="w-full max-w-3xl bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.015)] border border-gray-100 p-6 sm:p-10 transition-all duration-300">

                <div class="mb-8">
                    <h1 class="text-2xl sm:text-3xl font-black text-gray-900 uppercase tracking-tight">Update <span class="text-amber-800">The Product</span></h1>
                    <!-- <p class="text-xs text-gray-400 mt-1">Populate system architecture metrics to deploy a fresh stock line item into production.</p> -->
                </div>

                <form id="productForm" action="/admin/product/update/<%= item._id %>" method="POST" enctype="multipart/form-data" class="flex flex-col space-y-6">

                    <div class="flex flex-col space-y-2">
                        <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Product Blueprint Asset</label>

                        <div class="relative group">
                            <label id="dropZone" class="relative flex flex-col items-center justify-center w-full h-52 border-2 border-dashed border-gray-200 rounded-xl cursor-pointer bg-gray-50/50 hover:bg-gray-50/80 hover:border-amber-700 transition-all overflow-hidden">

                                <div id="defaultView" class="flex flex-col items-center justify-center pt-5 pb-6 text-center px-4 transition-opacity duration-300">
                                    <div class="p-3 bg-white rounded-xl shadow-[0_2px_10px_rgba(0,0,0,0.01)] text-gray-400 group-hover:text-amber-800 group-hover:scale-105 transition-all duration-300 mb-3 border border-gray-100">
                                        <i class="fas fa-cloud-upload-alt text-lg"></i>
                                    </div>
                                    <p class="text-xs text-gray-600 font-bold uppercase tracking-wide"><span class="text-amber-800">Click to upload asset</span> or drag drop file</p>
                                    <p class="text-[10px] text-gray-400 tracking-wider mt-1">Supports PNG, JPG, or high fidelity WEBP renders (Max. 5MB)</p>
                                </div>

                                <img id="imagePreview" src="" alt="Dynamic Visual Preview Asset" class="absolute inset-0 w-full h-full object-cover hidden rounded-xl" />

                                <input type="file" name="image" id="fileInput" class="hidden" accept="image/*" />
                            </label>

                            <button type="button" id="resetImage" class="absolute top-4 right-4 bg-white/90 backdrop-blur-md text-gray-700 w-8 h-8 rounded-full shadow-sm flex items-center justify-center hover:bg-rose-50 hover:text-rose-600 transition-all scale-0 opacity-0 z-10 border border-gray-100 cursor-pointer">
                                <i class="fas fa-times text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                        <div class="flex flex-col space-y-2 md:col-span-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Design Title</label>
                            <input class="w-full rounded-xl bg-gray-50/50 focus:bg-white border border-gray-100 focus:outline-none px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:border-amber-700 transition-all duration-200" 
                                required value="<%= item.name %>" placeholder="e.g., Suede Minimalist Tote" type="text" name="name">
                        </div>

                        <div class="flex flex-col space-y-2 md:col-span-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Total in Stock</label>
                            <input class="w-full rounded-xl bg-gray-50/50 focus:bg-white border border-gray-100 focus:outline-none px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:border-amber-700 transition-all duration-200" 
                               value="<%= item.stock %>" required placeholder="e.g., 20" type="number" min="0" name="stock">
                        </div>

                        <div class="flex flex-col space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Base Price ($)</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-xs font-bold text-gray-400">$</span>
                                <input class="w-full rounded-xl bg-gray-50/50 focus:bg-white border border-gray-100 focus:outline-none pl-9 pr-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:border-amber-700 transition-all duration-200 font-semibold" 
                                   value="<%= item.price %>" required placeholder="0.00" type="number" step="0.01" min="0" name="price">
                            </div>
                        </div>

                        <div class="flex flex-col space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Active Markdown Discount (%)</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-xs font-bold text-gray-400">%</span>
                                <input class="w-full rounded-xl bg-gray-50/50 focus:bg-white border border-gray-100 focus:outline-none pl-9 pr-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:border-amber-700 transition-all duration-200 font-semibold" 
                                    required placeholder="0" type="number" min="0" max="100" name="discount" value="<%= item.discount %>">
                            </div>
                        </div>

                        <div class="flex flex-col space-y-2 md:col-span-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Inventory Node Category Mapping</label>
                            <select class="w-full rounded-xl bg-gray-50/50 focus:bg-white border border-gray-100 focus:outline-none px-4 py-3 text-sm text-gray-700 focus:border-amber-700 transition-all duration-200 font-medium cursor-pointer" 
                                required name="category">
                                <option value="<%= item.category %>" disabled selected hidden>Select inventory operational node...</option>
                                <option value="HAND-BAG">Hand-bag</option>
                                <option value="BACK-PACK">Back-pack</option>
                                <option value="TRAVEL-BAG">Travel-bag</option>
                                <option value="OTHERS">Others</option>
                            </select>
                        </div>

                        <div class="flex flex-col space-y-2 md:col-span-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-400">Collection Style Mapping</label>
                            <select class="w-full rounded-xl bg-gray-50/50 focus:bg-white border border-gray-100 focus:outline-none px-4 py-3 text-sm text-gray-700 focus:border-amber-700 transition-all duration-200 font-medium cursor-pointer mb-2" 
                                required name="subCategory">
                                <option value="<%= item.subCategory %>" disabled selected hidden>Select inventory style variant...</option>
                                <option value="none">None / No Sub-Category</option>
                                <option value="urban">Urban Back-Pack</option>
                                <option value="luxury">Luxury Handbags</option>
                                <option value="duffles">Travel Duffles</option>
                            </select>

                            <label class="text-xs mt-3 font-bold uppercase tracking-wider text-gray-400">Product Description</label>
                            <textarea  class="w-full min-h-25 rounded-xl bg-gray-50/50 focus:bg-white border border-gray-100 focus:outline-none px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:border-amber-700 transition-all duration-200" 
                                placeholder="Write detailed premium description asset metrics..." name="description"><%= item.description %></textarea>
                        </div>

                    </div>

                    <div class="pt-4 border-t border-gray-50 flex justify-end">
                        <button type="submit" class="w-full sm:w-auto bg-gray-900 hover:bg-amber-800 text-white text-xs font-bold uppercase tracking-wider px-8 py-4 rounded-xl transition-all duration-200 cursor-pointer text-center shadow-sm hover:shadow active:scale-[0.98]">
                            <i class="fas fa-plus-circle mr-1.5 text-xs"></i> Update Item
                        </button>
                    </div>

                </form>
            </div>
        </main>
    </div>

    <script>
        const fileInput = document.getElementById('fileInput');
        const defaultView = document.getElementById('defaultView');
        const imagePreview = document.getElementById('imagePreview');
        const dropZone = document.getElementById('dropZone');
        const resetBtn = document.getElementById('resetImage');

        function showPreview(file) {
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (e) => {
                    imagePreview.src = e.target.result;
                    imagePreview.classList.remove('hidden');
                    defaultView.classList.add('opacity-0', 'pointer-events-none');

                    dropZone.classList.add('border-amber-700', 'bg-amber-50/20');
                    dropZone.classList.remove('border-gray-200');

                    resetBtn.classList.remove('scale-0', 'opacity-0');
                    resetBtn.classList.add('scale-100', 'opacity-100');
                };
            }
        }

        fileInput.addEventListener('change', (e) => {
            showPreview(e.target.files[0]);
        });

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-amber-700', 'bg-amber-50/20');
        });

        dropZone.addEventListener('dragleave', (e) => {
            e.preventDefault();
            if (imagePreview.classList.contains('hidden')) {
                dropZone.classList.remove('border-amber-700', 'bg-amber-50/20');
            }
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            fileInput.files = e.dataTransfer.files;
            showPreview(e.dataTransfer.files[0]);
        });

        resetBtn.addEventListener('click', (e) => {
            e.preventDefault();
            fileInput.value = '';
            imagePreview.src = '';
            imagePreview.className = 'absolute inset-0 w-full h-full object-cover hidden rounded-xl';
            defaultView.classList.remove('opacity-0', 'pointer-events-none');

            dropZone.classList.remove('border-amber-700', 'bg-amber-50/20');
            dropZone.classList.add('border-gray-200');

            resetBtn.classList.add('scale-0', 'opacity-0');
            resetBtn.classList.remove('scale-100', 'opacity-100');
        });
    </script>

</body>

</html>