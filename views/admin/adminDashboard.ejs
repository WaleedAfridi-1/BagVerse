<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BagVerse Admin | Corporate Command Center</title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom Style for sleek corporate feel -->
    <style>
        .custom-scroll::-webkit-scrollbar { height: 5px; width: 5px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 9999px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
    </style>
</head>
<body class="bg-slate-50 font-sans text-slate-900 antialiased min-h-screen flex relative selection:bg-slate-900 selection:text-white">

    <!-- 1. LEFT SIDEBAR (Mobile Responsive Drawer) -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200/60 transition-transform duration-300 transform -translate-x-full lg:translate-x-0 lg:static lg:block shrink-0">
        <%- include("../partials/adminSidebar")%>
    </aside>

    <!-- Sidebar Overlay for Mobile Screens -->
    <div id="sidebarOverlay" class="fixed inset-0 z-40 bg-slate-900/20 backdrop-blur-xs hidden lg:hidden transition-all duration-300"></div>

    <!-- 2. MAIN HUB WORKSPACE CONTENT -->
    <div class="flex-1 flex flex-col min-w-0 w-full">
        
        <!-- Top Workspace Bar / Control Header -->
        <header class="h-16 bg-white/80 backdrop-blur-md border-b border-slate-200/60 sticky top-0 flex items-center justify-between px-6 sm:px-8 z-30 shrink-0 gap-4">
            <div class="flex items-center gap-3">
                <!-- Hamburger Button: Visible only on Mobile/Tablet -->
                <button id="menuBtn" class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 active:scale-95 rounded-lg cursor-pointer transition-all">
                    <i class="fa-solid fa-bars-staggered text-base"></i>
                </button>
                <div class="space-y-0.5">
                    <h1 class="text-xs sm:text-sm font-bold tracking-wider text-slate-900 uppercase">Products Catalog</h1>
                    <p class="text-[11px] text-slate-400 hidden sm:block font-medium">Manage and monitor BagVerse stock inventory</p>
                </div>
            </div>
            
            <div class="flex items-center gap-4 shrink-0">
                <!-- Action Button: Add Product -->
                <a href="/admin/products/add" class="bg-slate-950 text-white px-4 py-2 rounded-lg text-xs font-bold tracking-wider hover:bg-slate-800 active:scale-[0.98] transition-all flex items-center gap-2 shadow-xs whitespace-nowrap uppercase">
                    <i class="fa-solid fa-plus text-[10px]"></i> <span>Add Product</span>
                </a>
            </div>
        </header>

        <!-- Main Body Flow Context -->
        <main class="flex-1 p-6 sm:p-8 overflow-y-auto space-y-6 max-w-[1600px] w-full mx-auto">
            
            <!-- UPPER KPI KANBAN METRICS CARD ROW -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- KPI Card 1 -->
                <div class="bg-white p-5 rounded-xl border border-slate-200/60 flex items-center justify-between transition-all group shadow-2xs">
                    <div class="space-y-1">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Active Inventory</span>
                        <p class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 font-mono"><%= activeInventory %></p>
                    </div>
                    <div class="w-10 h-10 bg-slate-50 border border-slate-100 rounded-lg flex items-center justify-center text-slate-600 group-hover:bg-slate-950 group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-box text-sm"></i>
                    </div>
                </div>
                <!-- KPI Card 2 -->
                <div class="bg-white p-5 rounded-xl border border-slate-200/60 flex items-center justify-between transition-all group shadow-2xs">
                    <div class="space-y-1">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Low Stock Alerts</span>
                        <p class="text-xl sm:text-2xl font-black tracking-tight text-rose-600 font-mono"><%= lowStockItems %> <span class="text-[10px] text-slate-400 font-normal tracking-normal uppercase">Units</span></p>
                    </div>
                    <div class="w-10 h-10 bg-rose-50 border border-rose-100/50 rounded-lg flex items-center justify-center text-rose-600 group-hover:bg-rose-600 group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-triangle-exclamation text-sm"></i>
                    </div>
                </div>
                <!-- KPI Card 3 -->
                <div class="bg-white p-5 rounded-xl border border-slate-200/60 flex items-center justify-between transition-all group shadow-2xs sm:col-span-2 lg:col-span-1">
                    <div class="space-y-1">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Total Valuation</span>
                        <p class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 font-mono">$<%= totalValuation.toFixed(2) %></p>
                    </div>
                    <div class="w-10 h-10 bg-emerald-50 border border-emerald-100/50 rounded-lg flex items-center justify-center text-emerald-600 group-hover:bg-emerald-950 group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-money-bill-trend-up text-sm"></i>
                    </div>
                </div>
            </div>

            <!-- LOWER DATA MANAGEMENT SHEETS CONTAINER -->
            <div class="bg-white rounded-xl border border-slate-200/60 overflow-hidden shadow-2xs">
                <!-- Master Table Header Filters -->
                <div class="p-5 border-b border-slate-200/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white">
                    <div class="flex items-center gap-2.5">
                        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">All Listed Items</h3>
                        <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-md font-mono"><%= products.length %> TOTAL</span>
                    </div>
                    <div class="flex items-center gap-3 w-full sm:w-auto">
                        <!-- Search Box -->
                        <div class="relative w-full sm:w-64">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text" id="tableSearch" placeholder="Filter systems stack..." class="w-full bg-slate-50 border border-slate-200 text-xs pl-8.5 pr-4 py-2 rounded-lg focus:outline-none focus:border-slate-900 focus:bg-white transition-colors placeholder:text-slate-400">
                        </div>
                    </div>
                </div>

                <!-- Core Dynamic Data Grid Table -->
                <div class="overflow-x-auto w-full custom-scroll">
                    <table class="w-full text-left border-collapse min-w-212.5">
                        <thead>
                            <tr class="bg-slate-50/70 border-b border-slate-200/60 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                <th class="p-4 pl-6 w-[40%]">Product Information</th>
                                <th class="p-4 w-[15%]">Category</th>
                                <th class="p-4 w-[15%]">Price</th>
                                <th class="p-4 w-[15%]">Stock Status</th>
                                <th class="p-4 pr-6 w-[15%] text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody" class="text-xs divide-y divide-slate-100 text-slate-700">
                             <% products.toReversed().forEach(item => { %>
                            <tr class="hover:bg-slate-50/40 transition-colors group">
                                <!-- Product details -->
                                <td class="p-4 pl-6 flex items-center gap-4">
                                    <div class="w-10 h-12 bg-slate-50 rounded-lg border border-slate-200/60 overflow-hidden flex items-center justify-center shrink-0 shadow-3xs">
                                        <img src="data:<%= item.imageType %>;base64,<%= item.image.toString('base64')%>" alt="<%= item.name %>" class="w-full h-full object-cover">
                                    </div>
                                    <div class="min-w-0 space-y-0.5">
                                        <a href="#" class="font-bold text-slate-900 hover:text-slate-700 block uppercase tracking-wide truncate max-w-55 sm:max-w-70 transition-colors"><%= item.name %></a>
                                        <span class="text-[9px] text-slate-400 font-mono block">MANIFEST: #<%= String(item._id).slice(-6).toUpperCase() %></span>
                                    </div>
                                </td>
                                <!-- Category -->
                                <td class="p-4">
                                    <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded-md text-[10px] font-bold uppercase tracking-wider inline-block"><%= item.category %></span>
                                </td>
                                <!-- Price -->
                                <td class="p-4 font-bold text-slate-900 font-mono">$<%= item.price %></td>
                                <!-- Stock Status -->
                                <td class="p-4">
                                    <span class="<%= item.stock === 0 ? 'text-rose-600 bg-rose-50 border-rose-100': item.stock < 5 ? 'text-amber-700 bg-amber-50 border-amber-100' : 'text-emerald-700 bg-emerald-50 border-emerald-100' %> inline-flex items-center gap-1 text-[9px] font-bold uppercase tracking-widest border px-2 py-0.5 rounded-md whitespace-nowrap">
                                        <% if(item.stock >= 5){%>
                                            IN STOCK [<%= item.stock%>]
                                        <%}else if(item.stock < 5 && item.stock > 0 ){%>
                                            CRITICAL [<%= item.stock%>]
                                        <%} else{%>
                                            DEPLETED
                                        <%}%>    
                                    </span>
                                </td>
                                <!-- Control Utilities (Real World Admin CRUD standard) -->
                                <td class="p-4 pr-6 text-right font-mono">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a href="/admin/products/edit/<%= item._id %>" class="p-1.5 text-slate-400 hover:text-slate-900 border border-transparent hover:border-slate-200 hover:bg-white rounded-md transition-all" title="Edit Catalog Asset">
                                            <i class="fa-solid fa-pen-to-square text-[11px]"></i>
                                        </a>
                                        <a href="/admin/products/delete/<%= item._id %>" onclick="return confirm('Are you sure you want to scrub this entry?')" class="p-1.5 text-slate-400 hover:text-rose-600 border border-transparent hover:border-rose-100 hover:bg-rose-50 rounded-md transition-all" title="Decommission Entry">
                                            <i class="fa-solid fa-trash-can text-[11px]"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- JavaScript to Handle Mobile Menu & Live Search Toggle -->
    <script>
        const menuBtn = document.getElementById('menuBtn');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const tableSearch = document.getElementById('tableSearch');

        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

        menuBtn.addEventListener('click', toggleSidebar);
        overlay.addEventListener('click', toggleSidebar);

        // Client-side architecture search feature for performance fluid workflow
        tableSearch.addEventListener('keyup', function(e) {
            const term = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#tableBody tr');
            
            rows.forEach(row => {
                const productName = row.querySelector('td a').textContent.toLowerCase();
                const category = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                if(productName.includes(term) || category.includes(term)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>