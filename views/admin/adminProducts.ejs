<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory & Products | BagVerse Corporate</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-slate-50 font-sans text-slate-900 antialiased min-h-screen flex relative">

    <aside id="sidebar"
        class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-100 transition-transform duration-300 transform -translate-x-full lg:translate-x-0 lg:static lg:block shrink-0">
        <%- include("../partials/adminSidebar") %>
    </aside>

    <div id="sidebarOverlay" class="fixed inset-0 z-40 bg-slate-900/40 hidden lg:hidden"></div>

    <main class="flex-1 p-4 sm:p-6 md:p-8 lg:p-10 transition-all duration-300 min-w-0 w-full">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 sm:mb-8">
            <div class="flex items-center gap-3">
                <button id="menuBtn"
                    class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-xl cursor-pointer transition-colors">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 md:text-3xl">Products
                        Management</h1>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1 hidden xs:block">Manage catalog, track inventory
                        status, and update product variants.</p>
                </div>
            </div>
            <a href="/admin/products/add"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm rounded-xl shadow-sm transition-colors cursor-pointer w-full sm:w-auto">
                <i class="fa-solid fa-plus text-xs"></i> Add New Product
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-6 sm:mb-8">
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-xs flex items-center gap-4">
                <div class="p-3 bg-slate-50 text-slate-700 rounded-xl shrink-0"><i class="fa-solid fa-tags fa-lg"></i>
                </div>
                <div class="min-w-0">
                    <span class="text-[10px] sm:text-xs font-medium text-slate-400 uppercase tracking-wider block">Total
                        Catalog</span>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mt-0.5 truncate">
                        <%= products.length %> Products
                    </h3>
                </div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-xs flex items-center gap-4">
                <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl shrink-0"><i
                        class="fa-solid fa-circle-check fa-lg"></i></div>
                <div class="min-w-0">
                    <span class="text-[10px] sm:text-xs font-medium text-slate-400 uppercase tracking-wider block">In
                        Stock</span>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mt-0.5 truncate">
                        <%= inStock %> Items
                    </h3>
                </div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-xs flex items-center gap-4">
                <div class="p-3 bg-amber-50 text-amber-600 rounded-xl shrink-0"><i
                        class="fa-solid fa-triangle-exclamation fa-lg"></i></div>
                <div class="min-w-0">
                    <span class="text-[10px] sm:text-xs font-medium text-slate-400 uppercase tracking-wider block">Low
                        Stock Alerts</span>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mt-0.5 truncate">
                        <%= lowStock.length %> Items
                    </h3>
                </div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-xs flex items-center gap-4">
                <div class="p-3 bg-rose-50 text-rose-600 rounded-xl shrink-0"><i
                        class="fa-solid fa-circle-xmark fa-lg"></i></div>
                <div class="min-w-0">
                    <span class="text-[10px] sm:text-xs font-medium text-slate-400 uppercase tracking-wider block">Out
                        of Stock</span>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mt-0.5 truncate">
                        <%= outOfStock.length %> Items
                    </h3>
                </div>
            </div>
        </div>

        <div
            class="bg-white p-4 rounded-t-2xl border-t border-x border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="relative w-full md:max-w-md">
                <i
                    class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" id="searchBar" name="searchBar"
                    placeholder="Search product name,category , subCategory..."
                    class="w-full pl-10 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 focus:bg-white transition-all">
            </div>

            <div
                class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 scrollbar-none w-full md:w-auto unique-scroll">
                <button
                    class="categoryBtn px-4 py-1.5 text-xs sm:text-sm font-medium rounded-lg whitespace-nowrap cursor-pointer bg-slate-900 text-white ">
                    All Catalog
                </button>

                <button
                    class="categoryBtn px-4 py-1.5 text-xs sm:text-sm font-medium rounded-lg whitespace-nowrap cursor-pointer text-slate-600 hover:bg-slate-50">
                    BACK-PACK
                </button>

                <button
                    class="categoryBtn px-4 py-1.5 text-xs sm:text-sm font-medium rounded-lg whitespace-nowrap cursor-pointer text-slate-600 hover:bg-slate-50">
                    HAND-BAG
                </button>

                <button
                    class="categoryBtn px-4 py-1.5 text-xs sm:text-sm font-medium rounded-lg whitespace-nowrap cursor-pointer text-slate-600 hover:bg-slate-50">
                    TRAVEL-BAG
                </button>
            </div>
        </div>

        <div class="bg-white border border-slate-100 rounded-b-2xl shadow-xs overflow-hidden">
            <div class="overflow-x-auto w-full">
                <table class="w-full text-left border-collapse min-w-175">
                    <thead>
                        <tr
                            class="bg-slate-50/75 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                            <th class="py-4 px-6 w-[40%]">Product Details</th>
                            <th class="py-4 px-6">Category</th>
                            <th class="py-4 px-6">Price</th>
                            <th class="py-4 px-6">Stock Level</th>
                            <th class="py-4 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
                        <% products.toReversed().forEach((item)=> { %>

                            <tr class="productRow hover:bg-slate-50/50 transition-colors">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div
                                            class="w-12 h-12 bg-slate-100 rounded-xl border border-slate-200/60 flex items-center justify-center text-slate-400 shrink-0 overflow-hidden">
                                            <img src="data:<%= item.imageType %>;base64,<%= item.image.toString('base64') %> "
                                                alt="" class="object-center">
                                        </div>
                                        <div class="min-w-0">
                                            <span
                                                class="font-semibold text-slate-900 hover:text-indigo-600 transition-colors cursor-pointer block truncate max-w-45 sm:max-w-xs">
                                                <%= item.name %>
                                            </span>
                                            <span
                                                class="text-xs text-slate-400 mt-0.5 inline-block bg-slate-50 px-2 py-0.5 rounded border border-slate-100">
                                                <%= item.subCategory %>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6 font-mono text-xs text-slate-500 tracking-tight whitespace-nowrap">
                                    <%= item.category %>
                                </td>
                                <td class="py-4 px-6 font-semibold text-slate-900 whitespace-nowrap">$<%= item.price %>
                                        </td>
                                <td class="py-4 px-6 whitespace-nowrap">
                                    <div class="flex flex-col gap-1">
                                        <span
                                            class="<%= item.stock === 0 ? 'text-red-600 bg-red-50 border-red-200/60':item.stock < 5 ? 'text-yellow-600 bg-yellow-50 border-yellow-200/60':'text-emerald-700 bg-emerald-50 border-emerald-200/60' %>   inline-flex items-center gap-1.5 px-2.5 py-0.5 w-fit text-xs font-medium   border  rounded-lg">
                                            <%= item.stock===0 ? 'Out Of Stock' :item.stock < 5 ? 'low Stock' :"InStock"
                                                %>
                                        </span>
                                        <span
                                            class="<%= item.stock === 0 ? 'text-red-600':item.stock < 5 ? 'text-yellow-600':'text-slate-400' %>  text-xs  pl-0.5">
                                            <%= item.stock %> units left
                                        </span>
                                    </div>
                                </td>
                                <td class="py-4 px-6 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/admin/products/edit/<%= item._id %>"
                                            class="p-2 text-slate-400 hover:text-indigo-600 bg-slate-50 hover:bg-indigo-50 rounded-lg transition-colors"
                                            title="Edit Product">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button
                                            class="p-2 text-slate-400 hover:text-rose-600 bg-slate-50 hover:bg-rose-50 rounded-lg transition-colors"
                                            title="Delete Product">
                                            <a href="/admin/products/delete/<%= item._id %>">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </a>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% })%>
                    </tbody>
                </table>
            </div>

        </div>
        
    </main>

    <script>
        // SideBar Variables
        const menuBtn = document.getElementById('menuBtn');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        // SearchBar Variables 
        const searchBar = document.querySelector("#searchBar");
        const productRows = document.querySelectorAll(".productRow");





        // side bar toggle 
        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }
        if (menuBtn) menuBtn.addEventListener('click', toggleSidebar);
        if (overlay) overlay.addEventListener('click', toggleSidebar);

        // Search Bar Code
        searchBar.addEventListener("input", function () {
            let value = this.value.toLowerCase();

            productRows.forEach(row => {

                let productName = row.querySelector("td span.font-semibold").innerText.toLowerCase();
                let category = row.querySelector("td:nth-child(2)").innerText.toLowerCase();
                let subCategory = row.querySelector("td span.text-xs").innerText.toLowerCase();


                if (
                    productName.includes(value) ||
                    category.includes(value) ||
                    subCategory.includes(value)
                ) {
                    row.style.display = "";
                }
                else {
                    row.style.display = "none";
                }

            });

        });




    
        // Button Category Filtering Code
        const buttons = document.querySelectorAll('.categoryBtn');

        buttons.forEach(btn => {
            btn.addEventListener("click", function () {
                buttons.forEach(button => {
                    button.classList.remove("bg-slate-900", "text-white");
                    button.classList.add("text-slate-600", "hover:bg-slate-50");
                });

                this.classList.remove("text-slate-600", "hover:bg-slate-50");
                this.classList.add("bg-slate-900", "text-white");

                let selectedCategory = this.innerText.trim().toLowerCase();

                productRows.forEach(row => {
                    let rowCategory = row.querySelector("td:nth-child(2)").innerText.trim().toLowerCase();

                 
                    if (selectedCategory === "all catalog" || rowCategory === selectedCategory) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            });
        });
    </script>
</body>

</html>