<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title><%= product.name %> | BagVerse</title>
</head>

<body class="min-h-screen bg-[#FCFCFC] text-neutral-900 antialiased font-sans flex flex-col justify-between selection:bg-black selection:text-white">
    <%- include("../partials/navbar") %>

    <main class="flex-1 max-w-6xl w-full mx-auto px-6 sm:px-8 lg:px-12 pt-28 pb-20">
        
        <!-- Breadcrumb Navigation -->
        <nav class="text-[10px] font-bold tracking-[0.2em] text-neutral-400 uppercase mb-10 flex items-center gap-2.5 font-mono">
            <a href="/" class="hover:text-black transition-colors">Home</a>
            <span class="text-neutral-300">/</span>
            <span class="text-neutral-500">Products</span>
            <span class="text-neutral-300">/</span>
            <span class="text-neutral-900"><%= product.name %></span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            <!-- Left Column: Balanced Studio Media Frame -->
            <div class="lg:col-span-6 flex justify-center w-full">
                <div class="w-full max-w-105 bg-white border border-neutral-200/80 p-4 transition-all duration-300 hover:border-neutral-400 flex items-center justify-center group">
                    <div class="w-full aspect-3/4 bg-neutral-50 overflow-hidden relative flex items-center justify-center">
                        <% if (product.image) { %>
                            <!-- Handling base64 vs plain URL string gracefully -->
                            <img src="<%= product.image.toString().startsWith('http') ? product.image : 'data:' + product.imageType + ';base64,' + product.image.toString('base64') %>" 
                                 alt="<%= product.name %>" 
                                 class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-102">
                        <% } else { %>
                            <div class="flex flex-col items-center gap-2 text-neutral-300 font-mono text-[9px] uppercase tracking-widest">
                                <i class="fa-solid fa-box-open text-2xl"></i>
                                Null Media Asset
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Right Column: Context & Dynamic Order Specs -->
            <div class="lg:col-span-6 space-y-8 font-mono lg:pt-2">
                
                <!-- Title & Structural Pricing -->
                <div class="space-y-3 pb-6 border-b border-neutral-200/60">
                    <span class="text-[9px] font-bold bg-neutral-950 text-white px-2.5 py-1 tracking-widest uppercase inline-block">
                        // PREMIUM COLLECTION
                    </span>
                    <h1 class="text-xl font-black tracking-wider text-neutral-900 uppercase">
                        <%= product.name %>
                    </h1>
                    <div class="text-lg font-black text-neutral-950 tracking-wider pt-1">
                        $<%= product.price %> <span class="text-[9px] font-normal text-neutral-400 tracking-normal uppercase">USD</span>
                    </div>
                </div>

                <!-- Product Manifest Description -->
                <div class="space-y-2">
                    <h3 class="text-[9px] font-bold uppercase tracking-widest text-neutral-400">// Specification Manifest</h3>
                    <p class="font-sans text-xs text-neutral-600 leading-relaxed max-w-md">
                        <%= product.description || 'No complementary technical specification logged for this specific production unit.' %>
                    </p>
                </div>

                <!-- Industrial Specs & Real-Time Stock Status -->
                <div class="border border-neutral-200/80 bg-white p-4 text-[9px] uppercase tracking-wider text-neutral-500 space-y-3 max-w-md">
                    <div class="flex justify-between items-center">
                        <span>Operational State:</span>
                        <% if (product.stock === 0) { %>
                            <span class="font-bold text-neutral-400 bg-neutral-100 px-2 py-0.5">// ARCHIVE / OUT</span>
                        <% } else if (product.stock < 5) { %>
                            <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 border border-amber-100">// SCARCE [<%= product.stock %> LEFT]</span>
                        <% } else { %>
                            <span class="font-bold text-green-700">// AVAILABLE IN STOCK</span>
                        <% } %>
                    </div>
                    <div class="flex justify-between items-center border-t border-neutral-100 pt-2">
                        <span>Logistics Hub:</span>
                        <span class="font-bold text-neutral-900">Complimentary Dispatch</span>
                    </div>
                </div>

                <!-- Transaction Operations CTA Block (Synced with Index Logic) -->
                <div class="pt-2 max-w-md">
                    <form action="/cart/add" method="POST">
                        <!-- Injection of your required hidden structural payloads -->
                        <input type="hidden" value="<%= product._id %>" name="productId">
                        <input type="hidden" value="<%= userId %>" name="userId">

                        <% if (product.stock === 0) { %>
                            <button type="button" disabled class="w-full bg-neutral-100 text-neutral-400 text-[10px] font-bold uppercase tracking-widest py-3.5 border border-neutral-200 cursor-not-allowed flex items-center justify-center gap-2">
                                Sold Out
                            </button>
                        <% } else { %>
                            <button type="submit" class="w-full bg-neutral-950 text-white text-[10px] font-bold uppercase tracking-[0.2em] py-3.5 rounded-none hover:bg-neutral-800 transition-all flex items-center justify-center gap-2 group cursor-pointer shadow-xs">
                                <i class="fa-solid fa-plus text-[9px] group-hover:rotate-90 transition-transform duration-300"></i>
                                + Add To Order
                            </button>
                        <% } %>
                    </form>
                    
                    <a href="/" class="block text-center mt-5 text-[9px] font-bold text-neutral-400 uppercase tracking-widest hover:text-black transition-colors">
                        &larr; Return to Core Collections
                    </a>
                </div>

            </div>
        </div>
    </main>

    <%- include("../partials/footer") %>
</body>

</html>